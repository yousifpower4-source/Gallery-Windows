    <SolidColorBrush x:Key="Sep" Color="#1A000000"/>
    <SolidColorBrush x:Key="Hover" Color="#0F000000"/>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="Seg" Color="#12000000"/>
    <SolidColorBrush x:Key="SegSel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Card" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="Lb" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hdr" Color="#E0FFFFFF"/>
    <SolidColorBrush x:Key="Pop" Color="#FFFFFF"/>

