{
  "name": "gallery-windows",
  "version": "1.0.0",
  "description": "Gallery",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.gallery.windows",
    "productName": "Gallery",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "artifactName": "Gallery-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Gallery-Portable-${version}.${ext}"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  },
  "author": "Gallery"
}